# Resend Email Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email address where admin/booking lead alerts should be sent
LEAD_NOTIFICATION_EMAIL=bookings@velvetgirlentertainment.com

# From-address for outgoing emails (must be a verified domain in Resend, or onboarding@resend.dev during testing)
RESEND_FROM_EMAIL=Velvet Girls VIP Dispatch <bookings@velvetgirlentertainment.com>

# Optional: override where contact form / job application notifications go.
# Falls back to LEAD_NOTIFICATION_EMAIL if not set.
CONTACT_NOTIFICATION_EMAIL=inquiries@velvetgirlentertainment.com
APPLICATION_NOTIFICATION_EMAIL=inquiries@velvetgirlentertainment.com
